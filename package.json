{
	"name": "pi-realtime",
	"version": "0.2.0",
	"packageManager": "pnpm@10.30.3",
	"private": false,
	"description": "Pi realtime voice with isolated global configuration and OpenAI/Azure API-key support.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rankun203/pi-realtime.git"
	},
	"homepage": "https://github.com/rankun203/pi-realtime#readme",
	"bugs": {
		"url": "https://github.com/rankun203/pi-realtime/issues"
	},
	"main": ".pi/extensions/pi-realtime/index.ts",
	"type": "commonjs",
	"files": [
		".pi/extensions/pi-realtime/**/*.ts",
		".pi/extensions/pi-realtime/**/*.html",
		".pi/extensions/pi-realtime/**/*.js",
		"README.md",
		"AGENTS.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			".pi/extensions/pi-realtime/index.ts"
		]
	},
	"scripts": {
		"format": "prettier --write . --ignore-path .gitignore",
		"format:check": "prettier --check . --ignore-path .gitignore",
		"test": "node .ai/validation/pi-realtime-config.mjs",
		"dashboard": "node apps/pi-agents/server.mjs",
		"gates:typecheck": "tsc -p tsconfig.json",
		"gates:validation": "for f in .ai/validation/pi-realtime-*.mjs; do node \"$f\" || exit 1; done",
		"gates:deslop": "npx --yes d3sl0p typescript --report-min error .pi/extensions/pi-realtime",
		"scans:deslop": "npx --yes d3sl0p typescript --fail-on none --report-min lead .pi/extensions/pi-realtime",
		"sentrux:baseline": "bash ${HOME}/.codex/skills/pi-extension-dev/scripts/sentrux-save-baseline.sh .pi/extensions/pi-realtime",
		"gates:structure": "test -f .pi/extensions/pi-realtime/.sentrux/baseline.json || npm run sentrux:baseline && sentrux gate .pi/extensions/pi-realtime && sentrux check .pi/extensions/pi-realtime",
		"gates:quality": "npm run gates:structure && npm run gates:deslop && npm run gates:typecheck && npm run gates:validation && pi --offline --no-session --no-tools -e .pi/extensions/pi-realtime/index.ts --list-models >/tmp/pi-realtime-quality-load.txt 2>&1"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"pi-package",
		"agent"
	],
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.74.0",
		"@earendil-works/pi-tui": "^0.74.0",
		"@types/node": "^25.6.2",
		"@types/ws": "^8.18.1",
		"prettier": "^3.9.6",
		"tsx": "^4.23.13",
		"typebox": "^1.3.30",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"openai": "^6.38.0",
		"ws": "^8.21.3"
	}
}
